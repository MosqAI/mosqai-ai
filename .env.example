# Copy to .env. Never commit .env.
AI_PORT=8000
MODEL_VERSION=mosqai-v1
MODEL_PATH=./models/yolov8n_mosquito.onnx
CONFIDENCE_THRESHOLD=0.5
# Shared secret the backend sends so only the backend can call this service
AI_SERVICE_TOKEN=change-me-dev-only

# Local PostgreSQL (see db/schema.sql)
DB_NAME=mosqai_local
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (only used when new mosquitoes are detected)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
