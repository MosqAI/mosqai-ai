# Copy to .env. Never commit .env.
# rules    = size/shape/contrast rules, no training needed (reports model_version rules-v2)
# yolo     = the ONNX model at MODEL_PATH, once trained on mosquitoes (see training/README.md)
# ensemble = counts only what both the model and the rules find (fewest false positives)
DETECTOR=rules
# Rules detector limits, in pixels of the 640x480 photo.
# Tune with: python -m src.rule_detector photo.jpg [empty_tube.jpg]
RULES_MIN_AREA=15
RULES_MAX_AREA=2500
RULES_MIN_ELONGATION=1.5
RULES_MIN_CONTRAST=40
# bright = LED-lit mosquito on a dark tube; dark = mosquito on a light surface.
# Only used for photos sent without an empty-tube background.
RULES_POLARITY=bright

# YOLO detector (DETECTOR=yolo or ensemble)
MODEL_VERSION=mosqai-v1
MODEL_PATH=./models/yolov8n_mosquito.onnx
CONFIDENCE_THRESHOLD=0.5
# Comma-separated class ids to count; empty counts every class (single-class model).
TARGET_CLASS_IDS=
# Shared secret callers send in the X-Service-Token header (same value as the device's secrets.h).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
# Upload every frame to Cloudinary mosqai_dataset/ for labelling and training (true/false)
COLLECT_MODE=false

# Supabase (run db/schema.sql in the Supabase SQL editor)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side secret key (Project Settings -> API Keys). Never expose it to a browser.
SUPABASE_SECRET_KEY=

# Cloudinary (frames with new mosquitoes, plus every frame in collect mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
